// TaskFlow Enterprise – Complete PostgreSQL Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum IssueType {
  EPIC
  STORY
  TASK
  BUG
  SUB_TASK
  IMPROVEMENT
  RESEARCH
  FEATURE_REQUEST
  SUPPORT_TICKET
  CUSTOM
}

enum IssuePriority {
  LOWEST
  LOW
  MEDIUM
  HIGH
  HIGHEST
  CRITICAL
}

enum IssueSeverity {
  TRIVIAL
  MINOR
  MAJOR
  CRITICAL
  BLOCKER
}

enum IssueStatus {
  TODO
  IN_PROGRESS
  TESTING
  CODE_REVIEW
  READY_FOR_QA
  QA_FAILED
  READY_FOR_RELEASE
  DONE
  CANCELLED
  BLOCKED
  CUSTOM
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum OnboardingFormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum FieldType {
  TEXT
  TEXTAREA
  DROPDOWN
  CHECKBOX
  RADIO
  DATE
  PHONE
  EMAIL
  FILE_UPLOAD
  IMAGE_UPLOAD
  ADDRESS
  COUNTRY
  GST_NUMBER
  PAN_NUMBER
  COMPANY_REG_NUMBER
  CUSTOM
  SECTION
}

enum ClientType {
  COMPANY
  INDIVIDUAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  REFERRAL
  COLD_CALL
  EMAIL
  SOCIAL
  EVENT
  PARTNER
  OTHER
}

enum DealStatus {
  OPEN
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum CrmActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  STATUS_CHANGE
  COMMENT
  WHATSAPP
  TASK
}

enum CrmTaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum CrmTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CrmCommDirection {
  INBOUND
  OUTBOUND
}

enum CrmCallStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  BUSY
  NO_ANSWER
  FAILED
  CANCELED
  LOGGED
}

enum CrmMessageStatus {
  DRAFT
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  LOGGED
}

enum NdaStatus {
  PENDING
  PREVIEWED
  ACCEPTED
  REJECTED
  SIGNED
  EXPIRED
}

enum SignatureType {
  DRAW
  TYPE
  UPLOAD
}

enum DocumentType {
  PAN
  GST
  CERTIFICATE
  IDENTITY
  ADDRESS_PROOF
  COMPANY
  TAX
  NDA
  PROJECT
  CUSTOM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationType {
  MENTION
  ASSIGNMENT
  DUE_REMINDER
  COMMENT
  STATUS_CHANGE
  ONBOARDING
  NDA
  SYSTEM
  PROJECT
  ISSUE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PERMISSION_CHANGE
  DOCUMENT_UPLOAD
  DIGITAL_SIGNATURE
  ISSUE_UPDATE
  TASK_UPDATE
  FORM_SUBMIT
  INVITE
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceBillingType {
  MILESTONE
  HOURLY
  TASK
  CUSTOM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

// ─────────────────────────────────────────────
// COMPANY & SUBSCRIPTION
// ─────────────────────────────────────────────

model Company {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  email           String
  phone           String?
  website         String?
  logo            String?
  address         String?
  city            String?
  state           String?
  country         String?
  postalCode      String?
  gstNumber       String?
  panNumber       String?
  registrationNo  String?
  status          CompanyStatus @default(TRIAL)
  settings        Json          @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  users             User[]
  roles             Role[]
  departments       Department[]
  teams             Team[]
  projects          Project[]
  clients           Client[]
  organizations     Organization[]
  contacts          Contact[]
  leads             Lead[]
  deals             Deal[]
  crmActivities     CrmActivity[]
  crmTasks          CrmTask[]
  crmNotes          CrmNote[]
  crmCallLogs       CrmCallLog[]
  crmEmails         CrmEmail[]
  crmWhatsAppMessages CrmWhatsAppMessage[]
  crmAttachments    CrmAttachment[]
  onboardingForms   OnboardingForm[]
  clientOnboardingAssignments ClientOnboardingAssignment[]
  documents         Document[]
  ndaTemplates      NdaTemplate[]
  notifications     Notification[]
  activityLogs      ActivityLog[]
  auditLogs         AuditLog[]
  invoices          Invoice[]
  subscription      Subscription?
  emailTemplates    EmailTemplate[]
  projectTemplates  ProjectTemplate[]
  workflows         Workflow[]
  supportTickets    SupportTicket[]
  leaves            Leave[]
  invitations       Invitation[]

  @@index([slug])
  @@index([status])
  @@map("companies")
}

model Subscription {
  id                 String             @id @default(cuid())
  companyId          String             @unique
  plan               String             @default("trial")
  status             SubscriptionStatus @default(TRIAL)
  seats              Int                @default(5)
  storageGb          Int                @default(10)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  metadata           Json               @default("{}")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─────────────────────────────────────────────
// AUTH, USERS, RBAC
// ─────────────────────────────────────────────

model User {
  id                String     @id @default(cuid())
  companyId         String?
  email             String     @unique
  passwordHash      String
  firstName         String
  lastName          String
  avatar            String?
  /// Normalized mobile; unique when set (used for client login)
  phone             String?    @unique
  status            UserStatus @default(PENDING_VERIFICATION)
  emailVerified     Boolean    @default(false)
  emailVerifiedAt   DateTime?
  twoFactorEnabled  Boolean    @default(false)
  twoFactorSecret   String?
  lastLoginAt       DateTime?
  lastLoginIp       String?
  timezone          String     @default("UTC")
  locale            String     @default("en")
  preferences       Json       @default("{}")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  company              Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  linkedClient         Client?               @relation("ClientLoginUser")
  roles                UserRole[]
  refreshTokens        RefreshToken[]
  sessions             Session[]
  projectMembers       ProjectMember[]
  teamMembers          TeamMember[]
  assignedIssues       Issue[]               @relation("IssueAssignee")
  reportedIssues       Issue[]               @relation("IssueReporter")
  comments             Comment[]
  attachments          Attachment[]
  watchers             IssueWatcher[]
  timeEntries          TimeEntry[]
  notifications        Notification[]
  activityLogs         ActivityLog[]
  auditLogs            AuditLog[]
  createdForms         OnboardingForm[]      @relation("FormCreator")
  formSubmissions      FormSubmission[]
  formAssignments      ClientOnboardingAssignment[] @relation("FormAssignmentAuthor")
  signatures           DigitalSignature[]
  uploadedDocuments    Document[]            @relation("DocumentUploader")
  supportTickets       SupportTicket[]       @relation("TicketCreator")
  assignedTickets      SupportTicket[]       @relation("TicketAssignee")
  leaves               Leave[]
  invitationsSent      Invitation[]          @relation("InvitationSender")
  passwordResetTokens  PasswordResetToken[]
  emailVerifyTokens    EmailVerificationToken[]
  ownedLeads           Lead[]                @relation("LeadOwner")
  ownedDeals           Deal[]                @relation("DealOwner")
  ownedContacts        Contact[]             @relation("ContactOwner")
  crmActivities        CrmActivity[]         @relation("CrmActivityAuthor")
  assignedCrmTasks     CrmTask[]             @relation("CrmTaskAssignee")
  createdCrmNotes      CrmNote[]             @relation("CrmNoteAuthor")
  crmCallLogs          CrmCallLog[]          @relation("CrmCallLogAuthor")
  crmEmails            CrmEmail[]            @relation("CrmEmailAuthor")
  crmWhatsAppMessages  CrmWhatsAppMessage[]  @relation("CrmWhatsAppAuthor")
  crmAttachments       CrmAttachment[]       @relation("CrmAttachmentUploader")
  createdInvoices      Invoice[]             @relation("InvoiceCreator")

  @@index([companyId])
  @@index([email])
  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  companyId   String?
  name        String
  slug        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, slug])
  @@index([slug])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verification_tokens")
}

model Invitation {
  id        String   @id @default(cuid())
  companyId String
  email     String
  roleId    String?
  token     String   @unique
  invitedBy String
  accepted  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sender  User    @relation("InvitationSender", fields: [invitedBy], references: [id])

  @@index([token])
  @@index([email])
  @@map("invitations")
}

// ─────────────────────────────────────────────
// TEAM MANAGEMENT
// ─────────────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teams   Team[]

  @@unique([companyId, name])
  @@map("departments")
}

model Team {
  id           String   @id @default(cuid())
  companyId    String
  departmentId String?
  name         String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  members    TeamMember[]

  @@unique([companyId, name])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Leave {
  id        String      @id @default(cuid())
  companyId String
  userId    String
  startDate DateTime
  endDate   DateTime
  type      String      @default("annual")
  reason    String?
  status    LeaveStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("leaves")
}

// ─────────────────────────────────────────────
// CLIENTS & ONBOARDING
// ─────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  companyId String
  name      String
  website   String?
  industry  String?
  phone     String?
  email     String?
  address   String?
  city      String?
  country   String?
  logo      String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clients   Client[]
  contacts  Contact[]
  leads     Lead[]
  deals     Deal[]
  crmNotes  CrmNote[]

  @@index([companyId])
  @@map("organizations")
}

model Contact {
  id             String   @id @default(cuid())
  companyId      String
  organizationId String?
  ownerId        String?
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  mobile         String?
  jobTitle       String?
  image          String?
  notes          String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  owner        User?         @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  leads        Lead[]
  deals        Deal[]
  crmTasks     CrmTask[]
  crmNotes     CrmNote[]
  callLogs     CrmCallLog[]
  emails       CrmEmail[]
  whatsappMessages CrmWhatsAppMessage[]
  attachments  CrmAttachment[]
  activities   CrmActivity[]

  @@index([companyId])
  @@index([email])
  @@index([organizationId])
  @@map("contacts")
}

model Client {
  id                  String     @id @default(cuid())
  companyId           String
  organizationId      String?
  /// Login user for this CRM client (portal account)
  userId              String?    @unique
  type                ClientType @default(COMPANY)
  name                String
  firstName           String?
  lastName            String?
  email               String
  phone               String?
  companyName         String?
  website             String?
  address             String?
  city                String?
  state               String?
  country             String?
  postalCode          String?
  gstNumber           String?
  panNumber           String?
  registrationNo      String?
  logo           String?
  status         String     @default("active")
  /// Shareable client onboarding setup journey
  setupToken     String?    @unique
  setupEnabled   Boolean    @default(false)
  requireNda     Boolean    @default(false)
  ndaTemplateId  String?
  accountSetupAt DateTime?
  ndaSignedAt    DateTime?
  metadata       Json       @default("{}")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user            User?            @relation("ClientLoginUser", fields: [userId], references: [id], onDelete: SetNull)
  ndaTemplate     NdaTemplate?     @relation("ClientSetupNda", fields: [ndaTemplateId], references: [id], onDelete: SetNull)
  convertedFromLead Lead?          @relation("LeadConvertedClient")
  projects        Project[]
  formSubmissions   FormSubmission[]
  documents         Document[]
  ndaSignatures     DigitalSignature[]
  invoices          Invoice[]
  supportTickets    SupportTicket[]
  deals             Deal[]
  crmActivities     CrmActivity[]
  specificForms     OnboardingForm[]              @relation("ClientSpecificForms")
  formAssignments   ClientOnboardingAssignment[]

  @@index([companyId])
  @@index([email])
  @@index([phone])
  @@index([type])
  @@index([setupToken])
  @@map("clients")
}

model Lead {
  id                String     @id @default(cuid())
  companyId         String
  organizationId    String?
  contactId         String?
  ownerId           String?
  title             String
  name              String
  firstName         String?
  lastName          String?
  email             String?
  phone             String?
  mobile            String?
  website           String?
  jobTitle          String?
  image             String?
  organizationName  String?
  type              ClientType @default(COMPANY)
  status            LeadStatus @default(NEW)
  source            LeadSource @default(OTHER)
  estimatedValue    Decimal?   @db.Decimal(12, 2)
  notes             String?
  lostReason        String?
  lostNotes         String?
  convertedClientId String?    @unique
  convertedAt       DateTime?
  archived          Boolean    @default(false)
  onBoard           Boolean    @default(false)
  metadata          Json       @default("{}")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contact         Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner           User?         @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  convertedClient Client?       @relation("LeadConvertedClient", fields: [convertedClientId], references: [id], onDelete: SetNull)
  deals           Deal[]
  activities      CrmActivity[]
  crmTasks        CrmTask[]
  crmNotes        CrmNote[]
  callLogs        CrmCallLog[]
  emails          CrmEmail[]
  whatsappMessages CrmWhatsAppMessage[]
  attachments     CrmAttachment[]

  @@index([companyId])
  @@index([companyId, onBoard])
  @@index([status])
  @@index([ownerId])
  @@index([email])
  @@index([contactId])
  @@map("leads")
}

model Deal {
  id                String     @id @default(cuid())
  companyId         String
  leadId            String?
  clientId          String?
  organizationId    String?
  contactId         String?
  ownerId           String?
  title             String
  amount            Decimal?   @db.Decimal(12, 2)
  status            DealStatus @default(OPEN)
  expectedCloseDate DateTime?
  notes             String?
  lostReason        String?
  lostNotes         String?
  website           String?
  image             String?
  metadata          Json       @default("{}")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner        User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities   CrmActivity[]
  crmTasks     CrmTask[]
  crmNotes     CrmNote[]
  callLogs     CrmCallLog[]
  emails       CrmEmail[]
  whatsappMessages CrmWhatsAppMessage[]
  attachments  CrmAttachment[]

  @@index([companyId])
  @@index([status])
  @@index([leadId])
  @@index([clientId])
  @@index([contactId])
  @@map("deals")
}

model CrmActivity {
  id          String          @id @default(cuid())
  companyId   String
  leadId      String?
  clientId    String?
  dealId      String?
  contactId   String?
  createdById String?
  type        CrmActivityType @default(NOTE)
  body        String
  metadata    Json            @default("{}")
  createdAt   DateTime        @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("CrmActivityAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([leadId])
  @@index([clientId])
  @@index([dealId])
  @@index([contactId])
  @@map("crm_activities")
}

model CrmTask {
  id           String          @id @default(cuid())
  companyId    String
  leadId       String?
  dealId       String?
  contactId    String?
  assignedToId String?
  title        String
  description  String?
  status       CrmTaskStatus   @default(TODO)
  priority     CrmTaskPriority @default(MEDIUM)
  dueDate      DateTime?
  metadata     Json            @default("{}")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal       Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedTo User?    @relation("CrmTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([status])
  @@index([dueDate])
  @@index([leadId])
  @@index([dealId])
  @@map("crm_tasks")
}

model CrmNote {
  id             String   @id @default(cuid())
  companyId      String
  leadId         String?
  dealId         String?
  contactId      String?
  organizationId String?
  createdById    String?
  title          String?
  body           String
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("CrmNoteAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([leadId])
  @@index([dealId])
  @@map("crm_notes")
}

model CrmCallLog {
  id           String           @id @default(cuid())
  companyId    String
  leadId       String?
  dealId       String?
  contactId    String?
  createdById  String?
  direction    CrmCommDirection @default(OUTBOUND)
  status       CrmCallStatus    @default(LOGGED)
  fromNumber   String?
  toNumber     String?
  durationSec  Int?
  recordingUrl String?
  provider     String?          // twilio | exotel | manual
  externalId   String?
  notes        String?
  metadata     Json             @default("{}")
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("CrmCallLogAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([leadId])
  @@index([dealId])
  @@index([externalId])
  @@map("crm_call_logs")
}

model CrmEmail {
  id          String           @id @default(cuid())
  companyId   String
  leadId      String?
  dealId      String?
  contactId   String?
  createdById String?
  direction   CrmCommDirection @default(OUTBOUND)
  status      CrmMessageStatus @default(LOGGED)
  subject     String
  body        String
  fromAddress String?
  toAddress   String?
  messageId   String?
  metadata    Json             @default("{}")
  sentAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("CrmEmailAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([leadId])
  @@index([dealId])
  @@map("crm_emails")
}

model CrmWhatsAppMessage {
  id          String           @id @default(cuid())
  companyId   String
  leadId      String?
  dealId      String?
  contactId   String?
  createdById String?
  direction   CrmCommDirection @default(OUTBOUND)
  status      CrmMessageStatus @default(LOGGED)
  body        String
  mediaUrl    String?
  fromNumber  String?
  toNumber    String?
  externalId  String?
  metadata    Json             @default("{}")
  sentAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("CrmWhatsAppAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([leadId])
  @@index([dealId])
  @@index([externalId])
  @@map("crm_whatsapp_messages")
}

model CrmAttachment {
  id           String   @id @default(cuid())
  companyId    String
  leadId       String?
  dealId       String?
  contactId    String?
  uploadedById String?
  fileName     String
  fileUrl      String
  mimeType     String?
  sizeBytes    Int?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal       Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("CrmAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([leadId])
  @@index([dealId])
  @@map("crm_attachments")
}

model OnboardingForm {
  id          String               @id @default(cuid())
  companyId   String
  createdById String
  /// When set, this form was created specifically for one client
  clientId    String?
  title       String
  description String?
  slug        String
  status      OnboardingFormStatus @default(DRAFT)
  settings    Json                 @default("{}")
  secureToken String               @unique @default(cuid())
  publishedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("FormCreator", fields: [createdById], references: [id])
  client      Client?          @relation("ClientSpecificForms", fields: [clientId], references: [id], onDelete: SetNull)
  pages       FormPage[]
  fields      FormField[]
  submissions FormSubmission[]
  assignments ClientOnboardingAssignment[]

  @@unique([companyId, slug])
  @@index([secureToken])
  @@index([clientId])
  @@map("onboarding_forms")
}

/// Assign a shared (or dedicated) onboarding form to a client
model ClientOnboardingAssignment {
  id           String   @id @default(cuid())
  companyId    String
  clientId     String
  formId       String
  assignedById String?
  status       String   @default("PENDING") // PENDING | COMPLETED | CANCELLED
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client     Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  form       OnboardingForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  assignedBy User?          @relation("FormAssignmentAuthor", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([clientId, formId])
  @@index([companyId])
  @@index([formId])
  @@map("client_onboarding_assignments")
}

model FormPage {
  id       String  @id @default(cuid())
  formId   String
  title    String
  order    Int     @default(0)
  settings Json    @default("{}")

  form   OnboardingForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  fields FormField[]
  sections FormSection[]

  @@index([formId])
  @@map("form_pages")
}

model FormSection {
  id          String  @id @default(cuid())
  pageId      String
  title       String
  description String?
  order       Int     @default(0)
  settings    Json    @default("{}")

  page   FormPage    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  fields FormField[]

  @@index([pageId])
  @@map("form_sections")
}

model FormField {
  id            String    @id @default(cuid())
  formId        String
  pageId        String?
  sectionId     String?
  type          FieldType
  label         String
  name          String
  placeholder   String?
  helpText      String?
  required      Boolean   @default(false)
  order         Int       @default(0)
  options       Json      @default("[]")
  validation    Json      @default("{}")
  conditional   Json      @default("{}")
  defaultValue  String?
  settings      Json      @default("{}")

  form    OnboardingForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  page    FormPage?      @relation(fields: [pageId], references: [id], onDelete: SetNull)
  section FormSection?   @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([formId])
  @@map("form_fields")
}

model FormSubmission {
  id          String               @id @default(cuid())
  formId      String
  clientId    String?
  submittedBy String?
  status      FormSubmissionStatus @default(DRAFT)
  data        Json                 @default("{}")
  ipAddress   String?
  userAgent   String?
  submittedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  form    OnboardingForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  client  Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user    User?          @relation(fields: [submittedBy], references: [id], onDelete: SetNull)

  @@index([formId])
  @@index([clientId])
  @@map("form_submissions")
}

// ─────────────────────────────────────────────
// DOCUMENTS & NDA
// ─────────────────────────────────────────────

model Document {
  id           String       @id @default(cuid())
  companyId    String
  clientId     String?
  projectId    String?
  uploadedById String
  folderId     String?
  name         String
  originalName String
  type         DocumentType @default(CUSTOM)
  mimeType     String
  size         Int
  storageKey   String
  storageUrl   String?
  version      Int          @default(1)
  parentId     String?
  tags         String[]     @default([])
  metadata     Json         @default("{}")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client     Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploadedBy User            @relation("DocumentUploader", fields: [uploadedById], references: [id])
  folder     DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  parent     Document?       @relation("DocumentVersions", fields: [parentId], references: [id])
  versions   Document[]      @relation("DocumentVersions")

  @@index([companyId])
  @@index([projectId])
  @@index([clientId])
  @@map("documents")
}

model DocumentFolder {
  id        String   @id @default(cuid())
  companyId String
  parentId  String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children DocumentFolder[] @relation("FolderTree")
  documents Document[]

  @@map("document_folders")
}

model NdaTemplate {
  id          String   @id @default(cuid())
  companyId   String
  title       String
  content     String   @db.Text
  storageKey  String?
  storageUrl  String?
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  signatures     DigitalSignature[]
  setupClients   Client[]           @relation("ClientSetupNda")

  @@index([companyId])
  @@map("nda_templates")
}

model DigitalSignature {
  id              String        @id @default(cuid())
  ndaTemplateId   String
  clientId        String?
  userId          String?
  status          NdaStatus     @default(PENDING)
  signatureType   SignatureType?
  signatureData   String?       @db.Text
  signedPdfKey    String?
  signedPdfUrl    String?
  ipAddress       String?
  userAgent       String?
  signedAt        DateTime?
  rejectedAt      DateTime?
  rejectReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  ndaTemplate NdaTemplate @relation(fields: [ndaTemplateId], references: [id], onDelete: Cascade)
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ndaTemplateId])
  @@index([clientId])
  @@map("digital_signatures")
}

// ─────────────────────────────────────────────
// PROJECTS
// ─────────────────────────────────────────────

model Project {
  id            String        @id @default(cuid())
  companyId     String
  clientId      String?
  key           String
  name          String
  description   String?
  status        ProjectStatus @default(PLANNING)
  startDate     DateTime?
  endDate       DateTime?
  avatar        String?
  settings      Json          @default("{}")
  templateId    String?
  portalToken   String?       @unique
  portalEnabled Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  archivedAt    DateTime?

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client      Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  members     ProjectMember[]
  sprints     Sprint[]
  issues      Issue[]
  milestones  Milestone[]
  clientTasks ClientTask[]
  components  Component[]
  versions    ProjectVersion[]
  labels      Label[]
  documents   Document[]
  activities  ActivityLog[]
  invoices    Invoice[]
  workflowId  String?
  workflow    Workflow?        @relation(fields: [workflowId], references: [id])

  @@unique([companyId, key])
  @@index([companyId])
  @@index([status])
  @@index([portalToken])
  @@map("projects")
}

model ProjectTemplate {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("project_templates")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  /// PLANNED | IN_PROGRESS | DONE
  status      String    @default("PLANNED")
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues      Issue[]
  clientTasks ClientTask[]
  invoices    Invoice[]

  @@index([projectId])
  @@map("milestones")
}

/// Client-facing deliverable tasks (separate from internal Issues)
model ClientTask {
  id             String    @id @default(cuid())
  projectId      String
  milestoneId    String?
  title          String
  description    String?
  /// TODO | IN_PROGRESS | DONE
  status         String    @default("TODO")
  estimatedHours Decimal?  @db.Decimal(8, 2)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([milestoneId])
  @@map("client_tasks")
}

model Component {
  id          String  @id @default(cuid())
  projectId   String
  name        String
  description String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@unique([projectId, name])
  @@map("components")
}

model ProjectVersion {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String?
  releasedAt  DateTime?
  archived    Boolean   @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[] @relation("FixVersion")

  @@unique([projectId, name])
  @@map("project_versions")
}

model Label {
  id        String @id @default(cuid())
  projectId String
  name      String
  color     String @default("#6366f1")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  IssueLabel[]

  @@unique([projectId, name])
  @@map("labels")
}

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  name      String
  goal      String?
  status    SprintStatus @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
  @@index([status])
  @@map("sprints")
}

// ─────────────────────────────────────────────
// ISSUES / TASKS / BUGS
// ─────────────────────────────────────────────

model Issue {
  id              String         @id @default(cuid())
  projectId       String
  number          Int
  key             String
  type            IssueType      @default(TASK)
  title           String
  description     String?        @db.Text
  status          IssueStatus    @default(TODO)
  customStatusId  String?
  priority        IssuePriority  @default(MEDIUM)
  severity        IssueSeverity?
  assigneeId      String?
  reporterId      String
  sprintId        String?
  milestoneId     String?
  componentId     String?
  fixVersionId    String?
  parentId        String?
  environment     String?
  dueDate         DateTime?
  estimatedHours  Float?
  storyPoints     Float?
  loggedHours     Float          @default(0)
  resolution      String?
  // Bug-specific
  stepsToReproduce String?       @db.Text
  expectedResult  String?        @db.Text
  actualResult    String?        @db.Text
  browser         String?
  os              String?
  device          String?
  isRegression    Boolean        @default(false)
  // Meta
  order           Int            @default(0)
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  resolvedAt      DateTime?
  closedAt        DateTime?

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?           @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter    User            @relation("IssueReporter", fields: [reporterId], references: [id])
  sprint      Sprint?         @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  milestone   Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  component   Component?      @relation(fields: [componentId], references: [id], onDelete: SetNull)
  fixVersion  ProjectVersion? @relation("FixVersion", fields: [fixVersionId], references: [id], onDelete: SetNull)
  parent      Issue?          @relation("IssueHierarchy", fields: [parentId], references: [id])
  children    Issue[]         @relation("IssueHierarchy")
  customStatus WorkflowStatus? @relation(fields: [customStatusId], references: [id], onDelete: SetNull)
  labels      IssueLabel[]
  comments    Comment[]
  attachments Attachment[]
  watchers    IssueWatcher[]
  timeEntries TimeEntry[]
  checklists  ChecklistItem[]
  linksFrom   IssueLink[]     @relation("LinkFrom")
  linksTo     IssueLink[]     @relation("LinkTo")

  @@unique([projectId, number])
  @@unique([key])
  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([type])
  @@index([sprintId])
  @@index([priority])
  @@map("issues")
}

model IssueLabel {
  id      String @id @default(cuid())
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([issueId, labelId])
  @@map("issue_labels")
}

model IssueLink {
  id         String @id @default(cuid())
  fromId     String
  toId       String
  linkType   String @default("relates_to")

  from Issue @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Issue @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, linkType])
  @@map("issue_links")
}

model IssueWatcher {
  id      String @id @default(cuid())
  issueId String
  userId  String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@map("issue_watchers")
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  body      String   @db.Text
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue   Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id])
  parent  Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentThread")

  @@index([issueId])
  @@map("comments")
}

model Attachment {
  id           String   @id @default(cuid())
  issueId      String?
  uploadedById String
  name         String
  mimeType     String
  size         Int
  storageKey   String
  storageUrl   String?
  createdAt    DateTime @default(now())

  issue      Issue? @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([issueId])
  @@map("attachments")
}

model ChecklistItem {
  id        String   @id @default(cuid())
  issueId   String
  title     String
  completed Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@map("checklist_items")
}

model TimeEntry {
  id          String   @id @default(cuid())
  issueId     String
  userId      String
  hours       Float
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([issueId])
  @@index([userId])
  @@map("time_entries")
}

// ─────────────────────────────────────────────
// WORKFLOW
// ─────────────────────────────────────────────

model Workflow {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  statuses WorkflowStatus[]
  transitions WorkflowTransition[]
  projects Project[]

  @@index([companyId])
  @@map("workflows")
}

model WorkflowStatus {
  id         String  @id @default(cuid())
  workflowId String
  name       String
  slug       String
  color      String  @default("#94a3b8")
  category   String  @default("todo") // todo | in_progress | done
  order      Int     @default(0)
  isInitial  Boolean @default(false)
  isFinal    Boolean @default(false)

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  issues   Issue[]
  fromTransitions WorkflowTransition[] @relation("FromStatus")
  toTransitions   WorkflowTransition[] @relation("ToStatus")

  @@unique([workflowId, slug])
  @@map("workflow_statuses")
}

model WorkflowTransition {
  id           String  @id @default(cuid())
  workflowId   String
  fromStatusId String
  toStatusId   String
  name         String
  requiresApproval Boolean @default(false)
  rules        Json    @default("{}")

  workflow   Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromStatus WorkflowStatus @relation("FromStatus", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus   WorkflowStatus @relation("ToStatus", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@map("workflow_transitions")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS, ACTIVITY, AUDIT
// ─────────────────────────────────────────────

model Notification {
  id        String              @id @default(cuid())
  companyId String
  userId    String
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String?
  data      Json                @default("{}")
  read      Boolean             @default(false)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([companyId])
  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  projectId  String?
  entityType String
  entityId   String
  action     String
  message    String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

model AuditLog {
  id         String      @id @default(cuid())
  companyId  String?
  userId     String?
  action     AuditAction
  entityType String?
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  device     String?
  browser    String?
  createdAt  DateTime    @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// INVOICES, SUPPORT, EMAIL
// ─────────────────────────────────────────────

model Invoice {
  id             String             @id @default(cuid())
  companyId      String
  clientId       String
  projectId      String?
  createdById    String?
  milestoneId    String?
  number         String
  title          String             @default("Invoice")
  billingType    InvoiceBillingType @default(CUSTOM)
  status         InvoiceStatus      @default(DRAFT)
  amount         Decimal            @db.Decimal(12, 2)
  currency       String             @default("AED")
  dueDate        DateTime?
  paidAt         DateTime?
  sentAt         DateTime?
  items          Json               @default("[]")
  notes          String?            @db.Text
  /// Uploaded PDF (optional — invoices can also be created in-app)
  pdfName        String?
  pdfMimeType    String?
  pdfSize        Int?
  pdfStorageKey  String?
  pdfStorageUrl  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@map("invoices")
}

model SupportTicket {
  id           String              @id @default(cuid())
  companyId    String
  clientId     String?
  createdById  String
  assigneeId   String?
  subject      String
  description  String              @db.Text
  status       SupportTicketStatus @default(OPEN)
  priority     IssuePriority       @default(MEDIUM)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  resolvedAt   DateTime?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy User    @relation("TicketCreator", fields: [createdById], references: [id])
  assignee  User?   @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([status])
  @@map("support_tickets")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  companyId String
  name      String
  subject   String
  body      String   @db.Text
  variables Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@map("email_templates")
}
