# Server
PORT=4000
NODE_ENV=development
# Comma-separated frontend URLs (no trailing slash)
CORS_ORIGIN=http://localhost:3000,https://your-frontend.up.railway.app

# Database (local Postgres, or Railway public proxy URL)
# Railway example:
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskflow?schema=public

# JWT
JWT_SECRET=change-me-super-secret-jwt-key
JWT_REFRESH_SECRET=change-me-super-secret-refresh-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# S3 / Cloudflare R2 (bucket example: vedha-system)
# Endpoint = account S3 API only (no /bucket-name suffix)
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=vedha-system
# Public URL: custom domain or R2 pub-…r2.dev development URL
S3_PUBLIC_URL=
# Optional local upload directory when S3 keys are empty (default: <cwd>/uploads)
# UPLOAD_DIR=./uploads

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=TaskFlow <noreply@example.com>
